{
  "opencollection": "1.0.0",
  "info": {
    "name": "Narmi Public account balances me API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "me",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List authenticated user information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.narmi.dev/v1/me/",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/v2/oauth/authorize/",
              "accessTokenUrl": "/v2/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List the authenticated users profile information.\n\nAll monetary values are represented in minor units, or the smallest unit of the currency with no decimal (e.g., cents). For example, $10.00 is represented as 1000.\n\n\n\n<i>How can we improve these docs?             <a href=\"mailto:docs+feedback@narmi.com\">Share your feedback.</a></i>"
        }
      ]
    }
  ],
  "bundled": true
}