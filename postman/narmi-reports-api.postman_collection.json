                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"account_uuids\": [\n    \"<uuid>\"\n  ],\n  \"max_date\": \"<date>\",\n  \"min_date\": \"<date>\",\n  \"bai_codes\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"format\": \"csv\",\n  \"filename\": \"<string>\"\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
